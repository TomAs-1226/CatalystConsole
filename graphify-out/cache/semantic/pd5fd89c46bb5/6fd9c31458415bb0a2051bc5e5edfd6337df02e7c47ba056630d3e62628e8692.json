md", "source_location": "L64-70", "weight": 1.0}, {"source": "src_app_paintpowerpanel", "target": "docs_settings_power_panel_needs_a_count", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L72-75", "weight": 1.0}, {"source": "docs_settings_power_panel_needs_a_count", "target": "readme_rule_3_never_invents_a_number", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L73-75", "weight": 1.0}, {"source": "src_app_setcamera", "target": "docs_settings_one_camera_two_surfaces", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L86", "weight": 1.0}, {"source": "src_app_applyfieldcamera", "target": "docs_settings_one_camera_two_surfaces", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L86", "weight": 1.0}, {"source": "src_app_paintcamera", "target": "docs_settings_one_camera_two_surfaces", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/settings.md", "source_location": "L86", "weight": 1.0}, {"source": "src_app_traillabel", "target": "docs_settings_trail_length_rebuild", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L87", "weight": 1.0}, {"source": "src_app_rebuildtilesoftype", "target": "docs_settings_trail_length_rebuild", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L87", "weight": 1.0}, {"source": "src_app_settings", "target": "docs_settings_opens_on_applies_at_launch", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L96", "weight": 1.