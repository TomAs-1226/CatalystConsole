rts_are_held", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L101", "weight": 1.0}, {"source": "src_app_setdemo", "target": "docs_settings_demo_is_amber", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L112-119", "weight": 1.0}, {"source": "docs_settings_demo_is_amber", "target": "readme_demo_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L106-119", "weight": 1.0}, {"source": "docs_settings_demo_is_amber", "target": "readme_rule_3_never_invents_a_number", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L114-116", "weight": 1.0}, {"source": "docs_settings_demo_is_amber", "target": "docs_settings_it_stands_down", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L115", "weight": 1.0}, {"source": "src_app_setupdatenote", "target": "docs_settings_release_notes_as_plain_text", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L130-132", "weight": 1.0}, {"source": "src_app_applyupdateinfo", "target": "docs_settings_release_notes_as_plain_text", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/settings.md", "source_location": "L130-132", "weight": 1.0}, {"source": "src_app_escapehtml", "target": "docs_settings_release_notes_as_plain_text", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L132", "weight": 1.0}, {"source": "docs_settings_about_reads_across", "target": "docs_readme_three_rules_restated", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L142-147", "weight": 1.0}, {"source": "src_app_ticklinkhistory", "target": "docs_settings_frames_counts_real_ones", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L149-152", "weight": 1.0}, {"source": "src_app_linklog", "target": "docs_settings_frames_counts_real_ones", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L149-152", "weight": 1.0}, {"source": "docs_settings_frames_counts_real_ones", "target": "readme_rule_3_never_invents_a_number", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L151-152", "weight": 1.0}, {"source": "docs_settings_frames_counts_real_ones", "target": "readme_demo_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L151-152", "weight": 1.0}, {"source": "src_app_probeassets", "target": "docs_settings_bundled_versus_switched_off", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L154-156", "weight": 1.0}, {"source": "src_app_assetlabel", "target": "docs_settings_bundled_versus_switched_off", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L154-156", "weight": 1.0}, {"source": "docs_settings_bundled_versus_switched_off", "target": "readme_rule_3_never_invents_a_number", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/settings.md", "source_location": "L154-156", "weight": 1.0}, {"source": "src_app_shortcuts", "target": "docs_settings_single_key_bindings", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L158-174", "weight": 1.0}, {"source": "src_app_typinginfield", "target": "docs_settings_single_key_bindings", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L171-174", "weight": 1.0}, {"source": "docs_settings_single_key_bindings", "target": "readme_rule_2_never_impedes_driving", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/settings.md", "source_location": "L171-174", "weight": 1.0}, {"source": "src_app_loadsettings", "target": "docs_settings_storage_checked_key_by_key", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L176-184", "weight": 1.0}, {"source": "src_app_savesettings", "target": "docs_settings_storage_checked_key_by_key", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L176-184", "weight": 1.0}, {"source": "docs_settings_storage_checked_key_by_key", "target": "readme_settings_storage_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L176-184", "weight": 1.0}, {"source": "docs_settings_storage_checked_key_by_key", "target": "readme_team_number_lives_in_backend_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md", "source_location": "L177-179", "weight": 1.0}, {"source": "docs_settings_storage_checked_key_by_key", "target": "readme_board_survives_bad_storage", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/settings.md", "source_location": "L181-184", "weight": 1.0}], "hyperedges": [{"id": "settings_non_blocking_contract", "label": "The Settings panel's non-blocking contract", "nodes": ["docs_settings_nothing_applies", "docs_settings_nothing_is_modal", "docs_settings_it_stands_down", "docs_settings_reset_arms_itself", "docs_settings_search_in_place"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/settings.md"}]}