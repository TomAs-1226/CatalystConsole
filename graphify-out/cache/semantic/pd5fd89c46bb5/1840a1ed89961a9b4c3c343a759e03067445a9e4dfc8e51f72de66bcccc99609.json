ts", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L106-109", "weight": 1.0}, {"source": "src_tauri_src_mcp_value_json", "target": "docs_mcp_nan_as_string", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/mcp.md", "source_location": "L106-109", "weight": 1.0}, {"source": "docs_mcp_nan_as_string", "target": "docs_mcp_absent_is_not_zero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L106-109", "weight": 1.0}, {"source": "src_tauri_src_mcp_ds_events", "target": "docs_mcp_quiet_session_versus_unreadable", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L110-112", "weight": 1.0}, {"source": "docs_mcp_quiet_session_versus_unreadable", "target": "readme_dslog_parser_fails_closed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L110-112", "weight": 1.0}, {"source": "src_tauri_src_mcp_field_map_candidates", "target": "docs_mcp_field_map_says_where_it_looked", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L113-115", "weight": 1.0}, {"source": "src_tauri_src_mcp_field_map", "target": "docs_mcp_field_map_says_where_it_looked", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L113-115", "weight": 1.0}, {"source": "src_tauri_src_mcp_server_physics", "target": "docs_mcp_advisory_travels_with_numbers", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/mcp.md", "source_location": "L136-138", "weight": 1.0}, {"source": "docs_mcp_advisory_travels_with_numbers", "target": "readme_physics_advisory_only", "relation": "references", "confi