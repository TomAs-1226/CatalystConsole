{"nodes": [{"id": "docs_installing_installing", "label": "Installing Catalyst Console", "file_type": "document", "source_file": "docs/installing.md", "source_location": "L1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three ways in, in the order most teams should pick: with the Catalyst desktop app, the standalone installer, or from source."}, {"id": "docs_installing_bundled_with_catalyst_app", "label": "Bundled with the Catalyst desktop app", "file_type": "concept", "source_file": "docs/installing.md", "source_location": "L5-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Driver Console entry appears in the sidebar. The console is a separate binary with its own release cadence, so the app asks whether one is bundled rather than offering a button that reports not found when pressed."}, {"id": "docs_installing_standalone_installer", "label": "The standalone installer", "file_type": "concept", "source_file": "docs/installing.md", "source_location": "L18-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About 3.5 MB, Start Menu entry and desktop shortcut. The usual case for the machine that actually runs matches."}, {"id": "docs_installing_from_source", "label": "Building from source", "file_type": "concept", "source_file": "docs/installing.md", "source_location": "L26-40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm install, npm run vendor, npm run build. Needs Rust and the WebView2 runtime that ships with Windows 11."}, {"id": "docs_installing_optional_field_bakes", "label": "The optional field bakes", "file_type": "concept", "source_file": "docs/installing.md", "source_location": "L42-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run field-cad bakes the KOP field CAD down to something a dashboard can carry; npm run field-collision derives collision geometry from it. Both optional \u2014 without them the field view draws itself from published dimensions."}, {"id": "docs_installing_quiet_update_check", "label": "The quiet update check", "file_type": "rationale", "source_file": "docs/installing.md", "source_location": "L72-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The console looks once at launch, quietly. If there is one a chip appears in the dock; if the machine cannot reach GitHub \u2014 on a field network the normal case \u2014 nothing appears at all. No prompt, no dialog, no interruption anywhere in this path, because an update notice is exactly the sort of thing rule two exists to keep away from a driver."}, {"id": "docs_installing_signed_releases", "label": "Signed releases", "file_type": "concept", "source_file": "docs/installing.md", "source_location": "L82-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Releases are signed and the installer verifies the signature, so an update tampered with in transit is refused rather than run."}], "edges": [{"source": "docs_installing_installing", "target": "readme_catalyst_console", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/installing.md", "source_location": "L1-3", "weight": 1.0}, {"source": "docs_installing_from_source", "target": "readme_strict_csp_vendored_three", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/installing.md", "source_location": "L38-40", "weight": 1.0}, {"source": "scripts_vendor", "target": "docs_installing_from_source", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/installing.md", "source_location": "L38-40", "weight": 1.0}, {"source": "scripts_field_cad", "target": "docs_installing_optional_field_bakes", "relation": "implements", "confidence": "EXT