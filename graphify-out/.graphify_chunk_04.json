{
  "nodes": [
    {
      "id": "src_index_app_shell",
      "label": "The app shell",
      "file_type": "document",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L9-83",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "One root div carrying the whole live state as data attributes — data-live, data-edit, data-linked, data-estop — with the top strip, the four views, and the dock inside it. The CSS reads the state off the root rather than each surface tracking it."
    },
    {
      "id": "src_index_top_strip",
      "label": "The top strip",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L11-37",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The wordmark, the link chip, Driver Station and FMS lamps, the loop time, the view tablist and the gear. The wordmark opens Settings on About — a discreet target rather than a dock button, because the board and the dock are working surfaces and neither has room for vanity."
    },
    {
      "id": "src_index_roving_tabindex_tablist",
      "label": "The tablist is one tab stop with arrow keys inside it",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L23-30",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Not four tab stops in a row. The roving tabindex is maintained by showView; the arrows are wired by wireTablist."
    },
    {
      "id": "src_index_four_views",
      "label": "The four views",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L39-53",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dashboard, Tune, Logs and Topics as tabpanels; the board is a grid of tiles and the other three are sheets."
    },
    {
      "id": "src_index_dock",
      "label": "The dock",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L55-82",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The state lamp with its name and source, edit layout, add component, the drop chip, the RTT chip and the demo button."
    },
    {
      "id": "src_index_drop_chip_hidden_by_default",
      "label": "The drop chip appears only once the link has dropped",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L72-73",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Silence is the normal state. A chip that is always there reporting zero is a chip a driver learns to stop reading."
    },
    {
      "id": "src_index_demo_switch_duplicated_on_purpose",
      "label": "The demo switch is duplicated on purpose",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L75-81",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Demo data is also a row in Settings, and that duplication is deliberate: while demo runs, the fact that the numbers are invented has to be visible on the dashboard itself, not filed away behind a panel nobody has open."
    },
    {
      "id": "src_index_settings_has_no_aria_modal",
      "label": "The Settings dialog deliberately carries no aria-modal",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L108-111",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "There is no focus trap and the dashboard behind is not inert, and that is the design rather than an oversight: rule two says nothing may impede driving, so this is a mode you step out of and not a window that holds you. Claiming modality would have been the markup saying one thing while the program did another."
    },
    {
      "id": "src_index_settings_rail_and_search",
      "label": "The settings rail and its search box",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L114-159",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Seven sections down the left — Robot, Devices, Field view, Dashboard, Data, Updates, About — with a search box above them. Typing filters every row in every section at once and leaves them where they are, so a match is changed in place rather than in a copy of itself."
    },
    {
      "id": "src_index_garage_card",
      "label": "The garage card markup",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L173-202",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A canvas for the plan, the name and sub-line, the spec groups, a copy button, and an empty state that says no robot has introduced itself. Nothing here is filled in by the console — a robot that publishes no sheet gets the empty state, and a group whose keys are absent does not appear at all."
    },
    {
      "id": "src_index_sctl_wrapper_rule",
      "label": "Every control sharing the row's right edge sits in an .sctl",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L280-289",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Including the ones wide enough to look like they hold that edge on their own — they agree at this width and diverge below 760px, where .sctl is what re-anchors them. Three controls are outside one and none of them wants to be in it: the address list and the paste box are the full width of a stacked row, and the hidden file input has no box to align. A wrapper that does nothing would be a worse lie than the note this replaced."
    },
    {
      "id": "src_index_status_under_the_rows",
      "label": "What happened goes under the rows, not inside one",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L409-411",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The same as the team note and the update note. A row says what a control does; what happened when you used it is the section speaking."
    },
    {
      "id": "src_index_paste_by_hand_floor",
      "label": "Paste it in by hand is the floor under import",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L372-374",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Its own row rather than an appendage. On a laptop with no file dialog and no clipboard permission this is the only way in, and it is where an export lands when there is nowhere else to put it."
    },
    {
      "id": "src_index_demo_toggle_is_amber",
      "label": "The demo toggle is amber, alone among the switches",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L425-428",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A .tog.hazard rather than the ordinary blue switch, because it is the one control on the panel that makes the console stop telling the truth about the robot."
    },
    {
      "id": "src_index_release_notes_as_pre",
      "label": "Release notes render into a pre, never as markup",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L474-480",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The text is the release's own, so it is shown as plain text rather than rendered: a note that arrived over the network is not markup this program should be executing."
    },
    {
      "id": "src_index_three_rules_in_about",
      "label": "The three rules, as About renders them",
      "file_type": "document",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L507-542",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "An ordered list numbered 01, 02, 03 under the line 'Everything here answers to these, in order, and they are not negotiable.' The one place in the running program where the rules are stated to the user rather than merely obeyed."
    },
    {
      "id": "src_index_live_diagnostics_grid",
      "label": "The live diagnostics grid",
      "file_type": "concept",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L544-558",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Connected to, round trip, topics, running for, NT frames and link drops, plus whether this build bundles the field model and the collision map."
    },
    {
      "id": "src_index_importmap_points_at_vendor",
      "label": "The import map points three at the vendored copy",
      "file_type": "rationale",
      "source_file": "C:\\Users\\yu_th\\dev\\CatalystConsole\\src\\index.html",
      "source_location": "L577-581",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "three.js and its loaders import the bare specifier 'three'; the import map points it at ./vendor/three.module.min.js so nothing reaches for a CDN under the strict CSP."
    }
  ],
